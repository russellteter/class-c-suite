  },
  "devDependencies": {
    "vitest": "^3.2.0",
    "typescript": "^5.8.0",
    "@types/node": "^22.0.0",
    "js-yaml": "^4.1.0",
    "@types/js-yaml": "^4.0.9",
    "electron-builder": "^26.8.1",
    "@electron/notarize": "^2.5.0",
    "@electron/osx-sign": "^1.3.1",
    "@electron/rebuild": "^3.7.0"
  }
