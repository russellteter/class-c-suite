{
  "name": "c-suite",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "pnpm -r --parallel run typecheck",
    "lint": "pnpm -r --parallel run lint",
    "test:unit": "vitest run",
    "test:fuzz": "vitest run --config vitest.fuzz.config.ts",
    "test:integration": "echo 'no integration tests at Ch.0'",
    "build:packages": "pnpm --filter @c-suite/shared-types build && pnpm --filter @c-suite/stub-harness build && pnpm --filter @c-suite/soql-builder build",
    "dev": "concurrently -k -n main,utility,renderer -c blue,magenta,green \"pnpm --filter @c-suite/main dev\" \"pnpm --filter @c-suite/utility dev\" \"pnpm --filter @c-suite/renderer dev\""
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "@electron/notarize": "^2.5.0",
    "@electron/osx-sign": "^1.3.1",
    "@electron/rebuild": "^3.7.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "better-sqlite3": "^12.10.0",
    "electron-builder": "^26.8.1",
    "js-yaml": "^4.1.0",
    "simple-git": "^3.36.0",
    "tsx": "^4.22.3",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
