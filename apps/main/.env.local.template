# apps/main/.env.local.template
# Copy to apps/main/.env.local (already gitignored) and paste your credentials.
# C-Suite reads these on first launch ONLY — after that, refresh tokens / API keys
# live in macOS Keychain via Electron safeStorage. You can revoke + re-add by
# repeating the OAuth flow in Settings → Reconnect.

# ── Salesforce (Connected App in Class org — see docs/setup/salesforce-connected-app.md) ──
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=

# ── Gmail (Google Cloud OAuth Desktop App — see docs/setup/gmail-oauth-app.md) ──
# Add your Gmail address as a TEST USER on the consent screen — required.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# ── Chorus (API key from Chorus admin → API tokens) ──
# Pasted once via Settings UI on first launch, OR set here for initial bootstrap.
CHORUS_API_KEY=

# ── NetSuite (OAuth 2.0 PUBLIC CLIENT + PKCE via the AI Connector Service) ──
# Register a NetSuite OAuth 2.0 Integration Record: Public Client, Authorization Code
# Grant, redirect URI = http://localhost:8765/oauth/callback, scope = mcp.
# Requires the MCP Standard Tools SuiteApp + a custom (non-Admin) MCP role with
# "MCP Server Connection" + "Log in using OAuth 2.0 Access Tokens" + "REST Web Services".
# NO client secret (public client). Credential-absent mode ships; safe to leave blank.
NETSUITE_ACCOUNT_ID=
NETSUITE_OAUTH_CLIENT_ID=
NETSUITE_OAUTH_REDIRECT_URI=http://localhost:8765/oauth/callback
NETSUITE_MCP_SERVER_URL=

# ── AWS (local SSO — no env vars needed) ──
# Run once per ~12hr session:
#   aws sso login --profile class && aws sso login --profile collab
# C-Suite reads ~/.aws/credentials + ~/.aws/config directly.

# ── PowerBI (customer-dashboard subprocess — no credentials in C-Suite) ──
# That project's own auth (Microsoft account + Google Sheets OAuth) is separate.
# C-Suite just shells out to its python3 src/main.py -j /tmp/cdash-<runId>.json.
